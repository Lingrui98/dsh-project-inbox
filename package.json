{
  "name": "@dsh-external/dsh-research-hub",
  "version": "0.2.0",
  "description": "Project workbench for DeepSeek Harness: cross-session inbox, automatic project attribution, interruption alerts, and external delivery",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": ["lib", "cordis.patch.yml", "LICENSE"],
  "license": "BSD-3-Clause",
  "author": "Lingrui98",
  "repository": {"type": "git", "url": "git+https://github.com/Lingrui98/dsh-research-hub.git"},
  "homepage": "https://github.com/Lingrui98/dsh-research-hub#readme",
  "bugs": {"url": "https://github.com/Lingrui98/dsh-research-hub/issues"},
  "keywords": ["dsh", "deepseek-harness", "plugin", "research", "dashboard", "inbox"],
  "engines": {"node": ">=24", "dsh": ">=0.2.0-rc.2 <0.3.0"},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "tsdown": "^0.22.14"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:client": "tsdown",
    "test": "node --test scripts/client-home.test.mjs scripts/client-i18n.test.mjs scripts/client-layout.test.mjs scripts/auq-mirror.test.mjs scripts/turn-alert.test.mjs scripts/auto-trash.test.mjs scripts/panel-perf.test.mjs scripts/discovery.test.mjs scripts/store-migration.test.mjs scripts/ingest-api.test.mjs scripts/webhook.test.mjs scripts/phase2-wiring.test.mjs scripts/sqlite-store.test.mjs scripts/portability.test.mjs",
    "test:package": "node --test scripts/package.test.mjs",
    "check:release": "npm run build && npm run build:client && npm test && npm run test:package"
  },
  "exports": {
    ".": {"types": "./lib/types/index.d.ts", "default": "./lib/index.js"},
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-slots"],
      "platform": "web"
    }
  }
}
